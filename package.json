{
	"name": "template-full-stack",
	"private": true,
	"description": "Full Stack Template demonstrating coding patterns and full stack model from Customware AI",
	"type": "module",
	"scripts": {
		"build:client": "react-router build",
		"build:server": "tsc --project server/tsconfig.json",
		"build": "pnpm run build:client && pnpm run build:server",
		"start": "node build/server/start.js",
		"start:e2e": "node tests/e2e/server-start.mjs",
		"typegen": "react-router typegen",
		"lint": "oxlint --type-aware --type-check --fix",
		"check": "react-router typegen && pnpm run lint",
		"test": "vitest run",
		"prepare:e2e": "tsx tests/e2e/prepare.ts",
		"e2e": "pnpm run build && playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx server/db/migrate.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@hono/trpc-server": "0.4.2",
		"@hookform/resolvers": "5.9.0",
		"@react-router/node": "7.18.2",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-table": "9.1.2",
		"@trpc/client": "11.18.0",
		"@trpc/react-query": "11.18.0",
		"@trpc/server": "11.18.0",
		"better-sqlite3": "12.11.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"dotenv": "17.4.2",
		"drizzle-orm": "0.45.2",
		"embla-carousel": "8.6.0",
		"embla-carousel-react": "8.6.0",
		"hono": "4.13.2",
		"input-otp": "1.4.2",
		"isbot": "5.2.1",
		"lucide-react": "1.31.0",
		"neverthrow": "8.2.0",
		"radix-ui": "1.6.7",
		"react": "19.2.8",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.8",
		"react-hook-form": "7.85.0",
		"react-is": "19.2.8",
		"react-resizable-panels": "4.12.2",
		"react-router": "7.18.2",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.6.0",
		"tailwindcss-animate": "1.0.7",
		"vaul": "1.1.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "1.59.1",
		"@react-router/dev": "7.18.2",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.4",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"drizzle-kit": "0.31.10",
		"jsdom": "29.1.1",
		"oxc-transform-react": "0.145.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "7.0.2001",
		"playwright": "1.59.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
